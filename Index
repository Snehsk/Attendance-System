    // 7. Camera Initialization (Clean & Robust)
    async function initCamera() {
      try {
        if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
          throw new Error("Camera access is not supported by this browser.");
        }

        const stream = await navigator.mediaDevices.getUserMedia({
          video: {
            facingMode: "user",
            width: { ideal: 640 },
            height: { ideal: 480 }
          },
          audio: false
        });
        video.srcObject = stream;
        video.onloadedmetadata = () => {
          video.play();
          onCameraReady();
        };
      } catch (err) {
        console.error("Camera access error:", err);
        alert("Camera unavailable. Allow camera access in your browser settings and reload the page.");
      }
    }

    // 8. Face-API.js Model Loader
    async function loadFaceApiModels(retryCount = 0) {
      const primaryUrl = "https://cdn.jsdelivr.net/npm/@vladmandic/face-api/model";
      const fallbackUrl = "https://raw.githubusercontent.com/vladmandic/face-api/master/model";
      const MODEL_URL = retryCount > 0 ? fallbackUrl : primaryUrl;

      try {
        loaderText.textContent = "Preparing user verification...";
        // Initialize TensorFlow.js backend (defaults to webgl or falls back to cpu)
        if (typeof faceapi !== 'undefined' && faceapi.tf) {
          try {
            await faceapi.tf.setBackend('webgl');
          } catch (e) {
            console.warn("WebGL not available, using CPU backend", e);
            await faceapi.tf.setBackend('cpu');
          }
          await faceapi.tf.ready();
        }

        await faceapi.nets.tinyFaceDetector.loadFromUri(MODEL_URL);
        await faceapi.nets.faceLandmark68Net.loadFromUri(MODEL_URL);
        await faceapi.nets.faceRecognitionNet.loadFromUri(MODEL_URL);

        modelsLoaded = true;
        modelLoader.classList.add('hidden');
        startFaceDetectionLoop();
      } catch (err) {
        console.error("Model load error:", err);
        loaderText.textContent = "User verification unavailable";
        const sub = document.querySelector('#modelLoader p.text-xs');
        if (sub) sub.textContent = "Retrying...";
        setTimeout(() => loadFaceApiModels(retryCount + 1), 2500);
      }
    }

    function onCameraReady() {
      overlayCanvas.width = video.videoWidth;
      overlayCanvas.height = video.videoHeight;
    }

    // Face must be reasonably centred and sized inside the oval (relaxed so blinking is not interrupted)
    function isDetectionInsideScannerOval(detection) {
      const box = detection.detection && detection.detection.box;
      if (!box || !video.videoWidth || !video.videoHeight) return false;

      const videoRect = video.getBoundingClientRect();
      const ovalRect = scannerOval.getBoundingClientRect();
      const scale = Math.max(videoRect.width / video.videoWidth, videoRect.height / video.videoHeight);
      const cropX = (video.videoWidth * scale - videoRect.width) / 2;
      const cropY = (video.videoHeight * scale - videoRect.height) / 2;

      // video is mirrored with CSS, so flip X
      const mirroredCenterX = video.videoWidth - (box.x + box.width / 2);
      const centerX = videoRect.left + mirroredCenterX * scale - cropX;
      const centerY = videoRect.top + (box.y + box.height / 2) * scale - cropY;

      const w = box.width * scale;
      const h = box.height * scale;
      if (w > ovalRect.width * 1.4 || h > ovalRect.height * 1.4) return false; // too close
      if (w < ovalRect.width * 0.4) return false;                              // too far

      const nx = (centerX - (ovalRect.left + ovalRect.width / 2)) / (ovalRect.width / 2);
      const ny = (centerY - (ovalRect.top + ovalRect.height / 2)) / (ovalRect.height / 2);
      return nx * nx + ny * ny <= 0.6;
    }

    // 9. Real-Time Detection & Active Liveness Loop (FAST)
    // Before the blink passes only light detection + landmarks run (small input, no delay).
    // The heavy 128-D descriptor is computed once AFTER liveness passes and then locked.
    let isDetecting = false;
    async function startFaceDetectionLoop() {
      if (!modelsLoaded || video.paused || video.ended || isDetecting) {
        requestAnimationFrame(startFaceDetectionLoop);
        return;
      }
      isDetecting = true;

      try {
        const wantDescriptor = livenessPassed && !descriptorLocked &&
          ((currentMode === 'punch' && currentUserProfile && currentUserProfile.isEnrolled && currentUserProfile.faceDescriptor) ||
           currentMode === 'enroll');

        const options = new faceapi.TinyFaceDetectorOptions({
          inputSize: wantDescriptor ? 224 : 160,
          scoreThreshold: 0.35
        });

        let task = faceapi.detectSingleFace(video, options).withFaceLandmarks();
        if (wantDescriptor) task = task.withFaceDescriptor();
        const detection = await task;

        if (detection) {
          consecutiveNoFaceFrames = 0;
          isFaceDetected = true;
          isFaceInOval = isDetectionInsideScannerOval(detection);

          // Face swap protection after liveness: sudden jump in face position resets everything
          const box = detection.detection.box;
          const center = { x: box.x + box.width / 2, y: box.y + box.height / 2, w: box.width };
          if (livenessPassed && lastBoxCenter &&
              Math.hypot(center.x - lastBoxCenter.x, center.y - lastBoxCenter.y) > lastBoxCenter.w * 0.6) {
            currentFaceDescriptor = null;
            resetLivenessState();
          }
          lastBoxCenter = center;

          if (isFaceInOval) {
            outOfOvalFrames = 0;
            dotFace.className = "w-2 h-2 rounded-full bg-emerald-400";
            textFace.textContent = "Face centered";
            scannerOval.classList.add('active');
            scannerOval.classList.remove('error');

            if (livenessPassed) {
              if (detection.descriptor && !descriptorLocked) {
                currentFaceDescriptor = detection.descriptor;
                descriptorLocked = true;
              }
            } else {
              processLiveness(detection.landmarks);
            }
          } else {
            outOfOvalFrames++;
            dotFace.className = "w-2 h-2 rounded-full bg-rose-400";
            textFace.textContent = "Center face in oval";
            scannerOval.classList.remove('active');
            scannerOval.classList.add('error');
            // small grace so one jittery frame does not wipe a blink in progress
            if (outOfOvalFrames > 6) {
              currentFaceDescriptor = null;
              resetLivenessState();
            }
          }

          updateStatusGuidance();
        } else {
          // Allow up to 8 dropped frames
          consecutiveNoFaceFrames++;
          isFaceInOval = false;
          if (consecutiveNoFaceFrames > 8) {
            isFaceDetected = false;
            currentFaceDescriptor = null;
            resetLivenessState();
            dotFace.className = "w-2 h-2 rounded-full bg-slate-500";
            textFace.textContent = "Face not detected";
            scannerOval.classList.remove('active', 'error');

            instructionText.textContent = "Center your face in the frame";
            instructionSub.textContent = "Keep your face visible and well lit";
            instructionText.className = "text-xs font-bold text-sky-300";
          }
        }

        evaluateControls();
      } catch (err) {
        console.warn("Detection loop error:", err);
      } finally {
        isDetecting = false;
        requestAnimationFrame(startFaceDetectionLoop); // no artificial delay
      }
    }

    // Dynamic Guidance & Status Updates
    function updateStatusGuidance() {
      const isActive = currentUserProfile && String(currentUserProfile.status || "").trim().toUpperCase() === "ACTIVE";

      if (isFaceDetected && !isFaceInOval) {
