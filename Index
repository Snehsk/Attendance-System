          instructionSub.textContent = "Contact HR if an update is required";
          instructionText.className = "text-xs font-bold text-amber-300";
        } else if (!livenessPassed) {
          instructionText.textContent = "Blink or smile now";
          instructionSub.textContent = "Live face only - photos and ID cards are rejected";
          instructionText.className = "text-xs font-bold text-amber-300";
        } else {
          instructionText.textContent = "Identity verified";
          instructionSub.textContent = "Select Register User to complete setup";
          instructionText.className = "text-xs font-bold text-emerald-400";
        }
      }
    }

    // 10. FAST ACTIVE LIVENESS (blink or smile) with anti photo / ID card / screen-tilt checks
    function processLiveness(landmarks) {
      if (livenessPassed) return;

      const leftEye = landmarks.getLeftEye();
      const rightEye = landmarks.getRightEye();
      const mouth = landmarks.getMouth();
      const nose = landmarks.getNose();
      const noseTip = nose[6];

      // 1. Minimum face size (blocks small photos / ID card thumbnails held far away)
      const eyeDist = Math.hypot(leftEye[0].x - rightEye[3].x, leftEye[0].y - rightEye[3].y) || 1;
      if (eyeDist < 45) {
        textLiveness.textContent = "Move closer to the camera";
        dotLiveness.className = "w-2 h-2 rounded-full bg-amber-400";
        earHistory = [];
        prevNose = null;
        return;
      }

      // 2. Measurements (all normalised by face size)
      const leftEAR = calculateEAR(leftEye);
      const rightEAR = calculateEAR(rightEye);
      const ear = (leftEAR + rightEAR) / 2;
      const mouthWidth = Math.hypot(mouth[0].x - mouth[6].x, mouth[0].y - mouth[6].y);
      const mouthHeight = Math.hypot(mouth[3].x - mouth[9].x, mouth[3].y - mouth[9].y);
      const smileRatio = mouthWidth / eyeDist;
      const mar = mouthHeight / (mouthWidth || 1);
      const vert = Math.hypot(nose[0].x - noseTip.x, nose[0].y - noseTip.y) / eyeDist; // vertical face size

      // 3. Per-frame motion: shaking / waving a photo or card -> restart tracking
      let motion = 0;
      if (prevNose) motion = Math.hypot(noseTip.x - prevNose.x, noseTip.y - prevNose.y) / eyeDist;
      prevNose = { x: noseTip.x, y: noseTip.y };
      if (motion > BLINK.maxFrameMotion) {
        earHistory = [];
        blinkState = 0;
        smileFrames = 0;
        textLiveness.textContent = "Hold still";
        dotLiveness.className = "w-2 h-2 rounded-full bg-sky-400";
        return;
      }

      // 4. Rolling open-eye history (self-corrects, no long calibration wait)
      earHistory.push({ e: ear, l: leftEAR, r: rightEAR, v: vert });
      if (earHistory.length > BLINK.historyLen) earHistory.shift();

      // smile baseline: 2 quick frames, then slow drift update
      if (calibFrames < 2) {
        baselineSmileRatio = (baselineSmileRatio * calibFrames + smileRatio) / (calibFrames + 1);
        baselineMAR = (baselineMAR * calibFrames + mar) / (calibFrames + 1);
        calibFrames++;
      } else if (blinkState < 2 && smileFrames === 0 && Math.abs(smileRatio - baselineSmileRatio) < 0.03) {
        baselineSmileRatio = baselineSmileRatio * 0.9 + smileRatio * 0.1;
        baselineMAR = baselineMAR * 0.9 + mar * 0.1;
      }

      if (earHistory.length < 3) {
        textLiveness.textContent = "Hold still";
        dotLiveness.className = "w-2 h-2 rounded-full bg-sky-400";
        return;
      }

      // -------------------------------------------------------------
      // ACTION A: BLINK (eyes close then re-open, both eyes, head steady)
      // A photo / ID card is static, so its eyes never close.
      // -------------------------------------------------------------
      if (blinkState < 2) {
        blinkState = 1;
        const prev = earHistory.slice(0, -1);
        const refE = Math.max(...earHistory.map(h => h.e));
        const refL = Math.max(...earHistory.map(h => h.l));
        const refR = Math.max(...earHistory.map(h => h.r));
        const vertRef = prev.reduce((s, h) => s + h.v, 0) / prev.length;

        const eyesClosed =
          refE >= BLINK.minOpenEAR &&
          ear <= refE * BLINK.closeRatio &&
          leftEAR <= refL * BLINK.eachEyeRatio &&
          rightEAR <= refR * BLINK.eachEyeRatio;

        // If the whole face got shorter, it is a tilting photo/card, not a blink
        const faceShapeStable = Math.abs(vert - vertRef) / (vertRef || 1) <= BLINK.maxVertChange;

        if (eyesClosed && faceShapeStable) {
          blinkState = 2;
          blinkCloseTime = Date.now();
          blinkRef = { e: refE, l: refL, r: refR };
          blinkNose = { x: noseTip.x, y: noseTip.y };
          blinkVert = vertRef;
          dotLiveness.className = "w-2 h-2 rounded-full bg-indigo-400 animate-ping";
          textLiveness.textContent = "Open your eyes";
        } else {
          dotLiveness.className = "w-2 h-2 rounded-full bg-amber-400 animate-pulse";
          textLiveness.textContent = "Blink or smile to verify";
        }
      } else if (blinkState === 2) {
        const elapsed = Date.now() - blinkCloseTime;
        if (ear >= blinkRef.e * BLINK.reopenRatio) {
          const headShift = Math.hypot(noseTip.x - blinkNose.x, noseTip.y - blinkNose.y) / eyeDist;
          const vertChange = Math.abs(vert - blinkVert) / (blinkVert || 1);
          if (elapsed <= BLINK.maxCloseMs && headShift <= BLINK.maxBlinkShift && vertChange <= BLINK.maxVertChange) {
            confirmLiveness("Live Person: Blink Verified");
            return;
          }
          blinkState = 1;
        } else if (elapsed > BLINK.maxCloseMs) {
          blinkState = 1;
          earHistory = [];
        }
      }

      // -------------------------------------------------------------
      // ACTION B: SMILE (mouth widens vs. the person's own baseline)
      // -------------------------------------------------------------
      if (blinkState < 2) {
        const smileDelta = smileRatio - baselineSmileRatio;
        const marDelta = mar - baselineMAR;
        const isDynamicSmile = (smileDelta >= 0.08) || (marDelta >= 0.10 && smileDelta >= 0.02);
        if (isDynamicSmile) {
          smileFrames++;
          textLiveness.textContent = "Smile detected";
          dotLiveness.className = "w-2 h-2 rounded-full bg-emerald-400 animate-pulse";
          if (smileFrames >= 2) {
            confirmLiveness("Live Person: Smile Verified");
            return;
          }
        } else {
          smileFrames = 0;
        }
      }
    }

    function confirmLiveness(statusLabel) {
      livenessPassed = true;
      blinkState = 3;
      dotLiveness.className = "w-2 h-2 rounded-full bg-emerald-400";
      textLiveness.textContent = "Live check passed";
      badgeLiveness.className = "bg-emerald-950/80 backdrop-blur px-2.5 py-1 rounded-full text-emerald-300 border border-emerald-700 flex items-center space-x-1.5 shadow-sm";

      scannerOval.classList.add('active');
      scannerOval.classList.remove('error');
    }

    function calculateEAR(eye) {
      const dist1 = euclideanPoints(eye[1], eye[5]);
      const dist2 = euclideanPoints(eye[2], eye[4]);
      const horizontal = euclideanPoints(eye[0], eye[3]);
      return horizontal === 0 ? 0 : (dist1 + dist2) / (2.0 * horizontal);
    }

    function euclideanPoints(p1, p2) {
      const dx = p1.x - p2.x;
      const dy = p1.y - p2.y;
      return Math.sqrt(dx * dx + dy * dy);
    }

    function calculateEuclidean(v1, v2) {
      if (!v1 || !v2 || v1.length !== v2.length) return 999;
      let sum = 0;
      for (let i = 0; i < v1.length; i++) {
        const d = v1[i] - v2[i];
        sum += d * d;
      }
      return Math.sqrt(sum);
    }

    function resetLivenessState() {
      livenessPassed = false;
      currentFaceDescriptor = null;
      descriptorLocked = false;
      calibFrames = 0;
      baselineEAR = 0;
      baselineSmileRatio = 0;
      baselineMAR = 0;
      calibNoseX = 0;
      calibNoseY = 0;
      blinkState = 0;
      blinkCloseTime = 0;
      smileFrames = 0;
      staticSpoofFrames = 0;
      earHistory = [];
      blinkRef = null;
      blinkNose = null;
      prevNose = null;
      lastBoxCenter = null;
      outOfOvalFrames = 0;
      dotLiveness.className = "w-2 h-2 rounded-full bg-slate-500";
      textLiveness.textContent = "Verification pending";
      badgeLiveness.className = "bg-slate-900/80 backdrop-blur px-2.5 py-1 rounded-full text-slate-300 border border-slate-700 flex items-center space-x-1.5";
    }

    // 11. Evaluate Button States (STRICT ANTI-PROXY & STATUS CHECK)
    function evaluateControls() {
      const isActive = currentUserProfile && String(currentUserProfile.status || "").trim().toUpperCase() === "ACTIVE";

      if (currentMode === 'punch') {
        const hasValidUser = currentUserProfile && isActive && currentUserProfile.isEnrolled;
        const faceMatch = hasValidUser && currentFaceDescriptor && currentUserProfile.faceDescriptor &&
                          isFaceDetected && isFaceInOval &&
                          calculateEuclidean(currentUserProfile.faceDescriptor, currentFaceDescriptor) <= faceThreshold;

        // STRICT ANTI-PROXY: Active Account + Geofence + Live Human Blink/Smile + Biometric Match ALL MANDATORY!
        const canPunch = isActive && isGeofenceValid && isFaceDetected && isFaceInOval && livenessPassed && faceMatch && !isSubmitting;

        btnPunchIn.disabled = !canPunch;
        btnPunchOut.disabled = !canPunch;

        if (!currentUserProfile) {
          punchHint.textContent = "Enter and verify your Employee ID first.";
        } else if (!isActive) {
          punchHint.textContent = "Account inactive. Contact HR for assistance.";
        } else if (!currentUserProfile.isEnrolled) {
          punchHint.innerHTML = "User registration required. <a href='javascript:switchTab(\"enroll\")' class='text-indigo-400 underline font-semibold'>Register User</a>.";
        } else if (!isGeofenceValid) {
          punchHint.textContent = "Move to an authorized work site to record attendance.";
        } else if (!isFaceDetected || !isFaceInOval) {
          punchHint.textContent = "Center your face inside the oval.";
        } else if (!livenessPassed) {
          punchHint.textContent = "Blink or smile to verify your identity.";
        } else if (!currentFaceDescriptor) {
          punchHint.textContent = "Checking your face...";
        } else if (!faceMatch) {
          punchHint.textContent = "Face does not match this profile. Check your employee details or contact HR.";
        } else {
          punchHint.textContent = "Identity verified. You may record attendance.";
        }
      } else {
        // STRICT ENROLLMENT: Active Account + Profile + Face Detected + Live Human Presence MANDATORY!
        const canEnroll = currentUserProfile && isActive && !currentUserProfile.isEnrolled && isFaceDetected && isFaceInOval && livenessPassed && !isSubmitting;
        btnEnroll.disabled = !canEnroll;
        if (canEnroll) {
          btnEnroll.className = "w-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-3.5 px-4 rounded-xl shadow-lg shadow-emerald-600/30 transition flex items-center justify-center space-x-2";
          btnEnroll.innerHTML = "<span>Identity Verified · Register User</span>";
        } else {
          btnEnroll.className = "w-full bg-indigo-600 disabled:bg-slate-800 disabled:text-slate-600 disabled:cursor-not-allowed hover:bg-indigo-500 text-white font-bold py-3.5 px-4 rounded-xl shadow-lg transition flex items-center justify-center space-x-2";
          btnEnroll.innerHTML = "<span>Register User</span>";
        }

        const enrollHint = document.getElementById('enrollHint');
        if (enrollHint) {
          if (!currentUserProfile) {
            enrollHint.textContent = "Verify your employee details to continue.";
            enrollHint.className = "text-center text-[11px] text-amber-400";
          } else if (!isActive) {
            enrollHint.textContent = "Account inactive. Contact HR for assistance.";
            enrollHint.className = "text-center text-[11px] text-rose-400 font-semibold";
          } else if (currentUserProfile.isEnrolled) {
            enrollHint.textContent = "User already registered. Contact HR if an update is required.";
            enrollHint.className = "text-center text-[11px] text-rose-400 font-semibold";
          } else if (!isFaceDetected || !isFaceInOval) {
            enrollHint.textContent = "Center your face inside the oval.";
            enrollHint.className = "text-center text-[11px] text-sky-300";
          } else if (!livenessPassed) {
            enrollHint.textContent = "Blink or smile to verify your identity.";
            enrollHint.className = "text-center text-[11px] text-amber-300 font-semibold";
          } else {
            enrollHint.textContent = "Identity verified. Select Register user to continue.";
            enrollHint.className = "text-center text-[11px] text-emerald-400 font-semibold";
          }
        }
      }
    }

    // 12. Capture Snapshot Image from Video Stream (High-Speed Optimized Thumbnail)
    function captureVideoFrame() {
      const snapCanvas = document.createElement('canvas');
      // 240x320 at 0.45 quality drops payload size from ~200KB down to ~10KB (a 95% reduction!)
      snapCanvas.width = 240;
      snapCanvas.height = 320;
      const ctx = snapCanvas.getContext('2d');
      ctx.translate(snapCanvas.width, 0);
      ctx.scale(-1, 1);
      ctx.drawImage(video, 0, 0, snapCanvas.width, snapCanvas.height);
      return snapCanvas.toDataURL('image/jpeg', 0.45);
    }

    // 13. Submit Punch In / Punch Out
    async function triggerPunch(type) {
      if (isSubmitting) return;

      if (!currentUserProfile || String(currentUserProfile.status || "").trim().toUpperCase() !== "ACTIVE") {
        showModalError("Account inactive. Contact HR for assistance.");
        return;
      }

      if (!isFaceDetected || !isFaceInOval) {
        showModalError("Center your face inside the oval and try again.");
        return;
      }

      if (!livenessPassed) {
        showModalError("Blink or smile to verify your identity.");
        return;
      }

      isSubmitting = true;
      evaluateControls();

      showModalProgress("Recording attendance", "Verifying your identity...", 20, "Identity check");
      const snapshot = captureVideoFrame();

      if (!currentFaceDescriptor) {
        updateModalProgress(35, "Identity check", "Verifying your identity...");
        try {
          const fullDetection = await faceapi
            .detectSingleFace(video, new faceapi.TinyFaceDetectorOptions({ inputSize: 224, scoreThreshold: 0.35 }))
            .withFaceLandmarks()
            .withFaceDescriptor();
          if (fullDetection && fullDetection.descriptor) {
            currentFaceDescriptor = fullDetection.descriptor;
          }
        } catch (e) {
          console.warn("Descriptor fallback failed:", e);
        }
      }

      if (!currentFaceDescriptor) {
        isSubmitting = false;
        evaluateControls();
        showModalError("Could not verify face. Please look directly at the camera and try again.");
        return;
      }

      updateModalProgress(55, "Location check", "Confirming your work location...");

      const payload = {
        empId: currentUserProfile.id,
        punchType: type,
        userLat: userLocation.lat,
        userLon: userLocation.lon,
        liveFaceVector: Array.from(currentFaceDescriptor),
        livenessPassed: livenessPassed,
        snapshotBase64: snapshot
      };

      // Active progress animator so the modal feels alive while backend responds
      let progressVal = 55;
      const progressTicker = setInterval(() => {
        if (progressVal < 92) {
          progressVal += 6;
          const label = progressVal > 80 ? "Saving your attendance record..." : "Confirming your identity and location...";
          updateModalProgress(progressVal, progressVal > 80 ? "Saving record" : "Final verification", label);
        }
      }, 350);

      try {
        const res = await callBackend('submitAttendance', payload);
        clearInterval(progressTicker);
        isSubmitting = false;

        if (res && res.success) {
          updateModalProgress(100, "Complete", "Attendance recorded successfully.");
          setTimeout(() => {
            showModalSuccess(res.data);
            resetLivenessState(); // next punch needs a fresh live check
          }, 300);
        } else {
          if (res && res.debug) console.warn("Server detail:", res.debug);
          showModalError(res ? res.message : "Submission failed.");
        }
      } catch (err) {
        clearInterval(progressTicker);
        isSubmitting = false;
        showModalError("Unable to record attendance. Check your connection and try again.");
      }
      evaluateControls();
    }

    // 14. Trigger Face Biometric Enrollment
    async function triggerEnrollment() {
      if (isSubmitting) return;

      if (!currentUserProfile) {
        alert("Verify your employee details to continue.");
        return;
      }

      if (String(currentUserProfile.status || "").trim().toUpperCase() !== "ACTIVE") {
        alert("Account inactive. Contact HR for assistance.");
        return;
      }

      if (currentUserProfile.isEnrolled) {
        alert("User already registered. Contact HR if an update is required.");
        return;
      }

      if (!isFaceDetected || !isFaceInOval) {
        alert("Center your face inside the oval and try again.");
        return;
      }

      if (!livenessPassed) {
        alert("Blink or smile to verify your identity.");
        return;
      }

      isSubmitting = true;
      evaluateControls();
      showModalProgress("Registering User", "Verifying your identity...", 25, "Identity check");

      try {
        let descriptor = currentFaceDescriptor;

        // Compute fresh 128-D vector directly from video frame if not already cached
        if (!descriptor) {
          const fullDetection = await faceapi
            .detectSingleFace(video, new faceapi.TinyFaceDetectorOptions({ inputSize: 224, scoreThreshold: 0.35 }))
            .withFaceLandmarks()
            .withFaceDescriptor();

          if (fullDetection && fullDetection.descriptor) {
            descriptor = fullDetection.descriptor;
          }
        }

        if (!descriptor) {
          isSubmitting = false;
          evaluateControls();
          showModalError("Could not detect face clearly. Please look directly into the oval and try again.");
          return;
        }

        updateModalProgress(55, "Saving registration", "Saving your User registration...");

        const snapshot = captureVideoFrame();
        const vectorArray = Array.from(descriptor);

        // Progress animator for enrollment
        let progressVal = 55;
        const progressTicker = setInterval(() => {
          if (progressVal < 92) {
            progressVal += 7;
            updateModalProgress(progressVal, "Saving registration", "Completing User registration...");
          }
        }, 350);

        let res;
        try {
          res = await callBackend('enrollFaceBiometrics', {
            empId: currentUserProfile.id,
            faceVector: vectorArray,
            snapshotBase64: snapshot,
            livenessPassed: livenessPassed
          });
        } finally {
          clearInterval(progressTicker);
        }
        isSubmitting = false;

        if (res && res.success) {
          updateModalProgress(100, "Complete", "User registered successfully.");
          showModal("Registration complete", res.message || "User registered successfully.");
          document.getElementById('modalBtnClose').classList.remove('hidden');
          currentUserProfile.isEnrolled = true;
          currentUserProfile.faceDescriptor = vectorArray;
          displayProfile(currentUserProfile);
          setTimeout(() => {
            closeModal();
            switchTab('punch');
          }, 1500);
        } else {
          showModalError(res ? res.message : "Enrollment failed.");
        }
      } catch (err) {
        isSubmitting = false;
        showModalError("Unable to register user. Check your connection and try again.");
      }
      evaluateControls();
    }

    // 15. Modal Helpers
    function showModalProgress(title, msg, percent, stepText) {
      const modal = document.getElementById('statusModal');
      document.getElementById('modalTitle').textContent = title;
      document.getElementById('modalMessage').textContent = msg;
      document.getElementById('modalIcon').textContent = "⏳";
      document.getElementById('modalIcon').className = "w-14 h-14 mx-auto rounded-full bg-indigo-600/20 text-indigo-400 flex items-center justify-center text-2xl mb-3 animate-pulse";

      const progWrap = document.getElementById('modalProgressWrap');
      const progBar = document.getElementById('modalProgressBar');
      const stepLabel = document.getElementById('modalStepText');
      if (progWrap) progWrap.classList.remove('hidden');
      if (progBar) progBar.style.width = (percent || 20) + "%";
      if (stepLabel) {
        stepLabel.classList.remove('hidden');
        stepLabel.textContent = stepText || "";
      }

      document.getElementById('modalDetails').classList.add('hidden');
      document.getElementById('modalBtnClose').classList.add('hidden');
      modal.classList.remove('hidden');
    }

    function updateModalProgress(percent, stepText, message) {
      const progBar = document.getElementById('modalProgressBar');
      const stepLabel = document.getElementById('modalStepText');
      const msgEl = document.getElementById('modalMessage');
      if (progBar && percent !== undefined) progBar.style.width = percent + "%";
      if (stepLabel && stepText) stepLabel.textContent = stepText;
      if (msgEl && message) msgEl.textContent = message;
    }

    function showModal(title, msg) {
      const modal = document.getElementById('statusModal');
      document.getElementById('modalTitle').textContent = title;
      document.getElementById('modalMessage').textContent = msg;
      document.getElementById('modalIcon').textContent = "⏳";
      document.getElementById('modalIcon').className = "w-14 h-14 mx-auto rounded-full bg-indigo-600/20 text-indigo-400 flex items-center justify-center text-2xl mb-3";

      const progWrap = document.getElementById('modalProgressWrap');
      const stepLabel = document.getElementById('modalStepText');
      if (progWrap) progWrap.classList.add('hidden');
      if (stepLabel) stepLabel.classList.add('hidden');

      document.getElementById('modalDetails').classList.add('hidden');
      document.getElementById('modalBtnClose').classList.add('hidden');
      modal.classList.remove('hidden');
    }

    function showModalSuccess(data) {
      const progWrap = document.getElementById('modalProgressWrap');
      const stepLabel = document.getElementById('modalStepText');
      if (progWrap) progWrap.classList.add('hidden');
      if (stepLabel) stepLabel.classList.add('hidden');

      document.getElementById('modalIcon').textContent = "✅";
      document.getElementById('modalIcon').className = "w-14 h-14 mx-auto rounded-full bg-emerald-600/20 text-emerald-400 flex items-center justify-center text-2xl mb-3";
      document.getElementById('modalTitle').textContent = "Attendance recorded";
      document.getElementById('modalMessage').textContent = "Your attendance has been recorded successfully.";

      document.getElementById('mEmp').textContent = data.employeeName;
      document.getElementById('mPunch').textContent = data.punchType;
      document.getElementById('mTime').textContent = data.time;
      document.getElementById('mSite').textContent = data.location;

      document.getElementById('modalDetails').classList.remove('hidden');
      document.getElementById('modalBtnClose').classList.remove('hidden');
    }

    function showModalError(msg) {
      const progWrap = document.getElementById('modalProgressWrap');
      const stepLabel = document.getElementById('modalStepText');
      if (progWrap) progWrap.classList.add('hidden');
      if (stepLabel) stepLabel.classList.add('hidden');

      document.getElementById('modalIcon').textContent = "❌";
      document.getElementById('modalIcon').className = "w-14 h-14 mx-auto rounded-full bg-rose-600/20 text-rose-400 flex items-center justify-center text-2xl mb-3";
      document.getElementById('modalTitle').textContent = "Unable to complete";
      document.getElementById('modalMessage').textContent = msg;
      document.getElementById('modalDetails').classList.add('hidden');
      document.getElementById('modalBtnClose').classList.remove('hidden');
    }

    function closeModal() {
      document.getElementById('statusModal').classList.add('hidden');
    }
  </script>
