<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>GHCL | Employee Attendance</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">

  <!-- Design disabled for now; enable when the visual layout is ready.
  <script src="https://cdn.tailwindcss.com"></script>
  -->
  <!-- Face API JS -->
  <script src="https://cdn.jsdelivr.net/npm/@vladmandic/face-api/dist/face-api.min.js"></script>

  <style>
    * {
      box-sizing: border-box;
    }

    .hidden {
      display: none !important;
    }

    body {
      min-height: 100vh;
      margin: 0;
      background: #f3f5f7;
      color: #202a33;
      font-family: "Segoe UI", Arial, sans-serif;
      line-height: 1.45;
    }

    header {
      position: sticky;
      top: 0;
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 12px 18px;
      background: #fff;
      border-bottom: 1px solid #d9dfe5;
    }

    header h1,
    header p {
      margin: 0;
    }

    header h1 {
      font-size: 16px;
    }

    #liveClock {
      color: #64717c;
      font-size: 12px;
      font-variant-numeric: tabular-nums;
    }

    main {
      display: flex;
      width: min(100%, 520px);
      flex-direction: column;
      gap: 12px;
      margin: 0 auto;
      padding: 16px;
    }

    main > div:not(#cameraViewport) {
      padding: 12px;
      background: #fff;
      border: 1px solid #d9dfe5;
      border-radius: 6px;
    }

    #geoPill,
    #geoPill > div:first-child,
    #employeeSearchRow {
      display: flex;
    }

    #geoPill {
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    #geoPill > div:first-child {
      align-items: center;
      gap: 10px;
      min-width: 0;
    }

    #geoTitle {
      font-weight: 600;
    }

    #geoSubtitle,
    #punchHint,
    #enrollHint {
      color: #64717c;
      font-size: 12px;
    }

    #empInput {
      min-width: 0;
      flex: 1;
      padding: 9px 10px;
      border: 1px solid #c7d0d9;
      border-radius: 4px;
      color: #202a33;
      background: #fff;
      font: inherit;
    }

    button {
      padding: 8px 12px;
      border: 1px solid #c7d0d9;
      border-radius: 4px;
      color: #26333d;
      background: #f7f9fa;
      font: inherit;
      cursor: pointer;
    }

    button:disabled {
      cursor: not-allowed;
      opacity: 0.55;
    }

    #btnSearchEmp,
    #btnPunchIn,
    #btnPunchOut,
    #btnEnroll {
      border-color: #176b67;
      color: #fff;
      background: #176b67;
    }

    #cameraViewport {
      margin: 0 auto;
      background: #161b20;
      border: 1px solid #c7d0d9;
      border-radius: 6px;
    }

    #scannerOval {
      border: 2px dashed rgba(255, 255, 255, 0.75);
      border-radius: 50%;
    }

    #scannerOval.active {
      border-style: solid;
      border-color: #36b37e;
    }

    #scannerOval.error {
      border-style: solid;
      border-color: #d9534f;
    }

    #cameraViewport > div:last-child {
      position: absolute;
      right: 12px;
      bottom: 12px;
      left: 12px;
      display: flex;
      justify-content: space-between;
      gap: 8px;
    }

    #modelLoader {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 16px;
      background: rgba(255, 255, 255, 0.94);
      color: #202a33;
      text-align: center;
    }

    #cameraViewport {
      position: relative;
      width: min(100%, 480px);
      aspect-ratio: 4 / 3;
      max-height: 360px;
      overflow: hidden;
    }

    #videoElement,
    #overlayCanvas {
      width: 100%;
      height: 100%;
    }

    #videoElement {
      object-fit: cover;
      transform: scaleX(-1);
    }

    #overlayCanvas {
      position: absolute;
      inset: 0;
      pointer-events: none;
      transform: scaleX(-1);
    }

    #scannerOval {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 190px;
      height: 240px;
      transform: translate(-50%, -50%);
      pointer-events: none;
    }

    #modelLoader {
      position: absolute;
      inset: 0;
      z-index: 2;
    }

    #livenessInstruction {
      position: absolute;
      top: 12px;
      left: 12px;
      right: 12px;
      z-index: 1;
    }

    #badgeFace,
    #badgeLiveness {
      position: relative;
      z-index: 1;
    }

    #statusModal:not(.hidden) {
      position: fixed;
      inset: 0;
      z-index: 3;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
      background: rgba(20, 29, 36, 0.65);
    }

    #statusModal > div {
      width: min(100%, 400px);
      padding: 20px;
      border: 1px solid #d9dfe5;
      border-radius: 6px;
      background: #fff;
      text-align: center;
    }

    @media (max-width: 520px) {
      header {
        align-items: flex-start;
        padding: 10px 12px;
      }

      main {
        padding: 12px;
      }

      header button {
        padding: 7px 8px;
        font-size: 12px;
      }
    }
  </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col justify-between">

  <!-- Top Navigation & Status Bar -->
  <header class="bg-slate-800/90 backdrop-blur border-b border-slate-700 px-4 py-3 sticky top-0 z-30 flex items-center justify-between">
    <div class="flex items-center space-x-2">
      <div class="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center font-bold text-white shadow-md text-base">
        🏢
      </div>
      <div>
        <h1 class="text-sm font-semibold text-white tracking-wide">Employee Attendance</h1>
        <p id="liveClock" class="text-xs text-slate-400 font-mono">--:--:--</p>
      </div>
    </div>

    <!-- Header Right Controls -->
    <div class="flex items-center space-x-2 shrink-0">
      <!-- Mode Switcher -->
      <div class="flex items-center space-x-1 bg-slate-900/80 p-1 rounded-lg border border-slate-700 text-xs">
        <button id="tabPunch" onclick="switchTab('punch')" class="px-2.5 py-1.5 rounded-md font-medium bg-indigo-600 text-white transition">
          Attendance
        </button>
        <button id="tabEnroll" onclick="switchTab('enroll')" class="px-2.5 py-1.5 rounded-md font-medium text-slate-400 hover:text-white transition">
          User Registration
        </button>
      </div>
    </div>
  </header>

  <!-- Main Content Area -->
  <main class="flex-1 max-w-md w-full mx-auto p-4 flex flex-col space-y-3">

    <!-- Location Geofence Pill -->
    <div id="geoPill" class="bg-slate-800 border border-slate-700 rounded-xl p-3 flex items-center justify-between shadow-sm transition">
      <div class="flex items-center space-x-3 overflow-hidden">
        <span id="geoIcon" class="text-xl">📍</span>
        <div class="truncate">
          <div id="geoTitle" class="text-xs font-bold text-slate-300">Checking work location</div>
          <div id="geoSubtitle" class="text-[11px] text-slate-400 truncate">Allow location access to verify your site</div>
        </div>
      </div>
          <button onclick="refreshGPS()" title="Refresh location" aria-label="Refresh location" class="text-xs bg-slate-700 hover:bg-slate-600 px-2 py-1 rounded text-slate-300 transition">
        ↻
      </button>
    </div>

    <!-- Employee Identifier / Profile Bar -->
    <div class="bg-slate-800 border border-slate-700 rounded-xl p-3 shadow-sm">
      <div id="employeeSearchRow" class="flex items-center space-x-2">
        <input
          type="text"
          id="empInput"
          placeholder="Employee ID or work email"
          class="flex-1 bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 font-mono uppercase"
        />
        <button
          id="btnSearchEmp"
          onclick="searchEmployee()"
          class="bg-indigo-600 hover:bg-indigo-500 text-white px-3 py-2 rounded-lg text-xs font-semibold tracking-wide transition shadow"
        >
          Verify
        </button>
      </div>

      <!-- Employee Info Strip -->
      <div id="empInfoStrip" class="hidden mt-2 pt-2 border-t border-slate-700/60 flex items-center justify-between text-xs">
        <div>
          <span id="empNameDisplay" class="font-bold text-white"></span>
          <span id="empDeptDisplay" class="text-slate-400 ml-1"></span>
        </div>
        <div class="flex items-center space-x-1.5 shrink-0">
          <div id="empStatusBadge" class="px-2 py-0.5 rounded text-[10px] font-semibold"></div>
          <div id="empEnrolledBadge" class="px-2 py-0.5 rounded text-[10px] font-semibold"></div>
        </div>
      </div>
    </div>

    <!-- Camera Viewport Box -->
    <div id="cameraViewport" class="relative w-full aspect-[4/3] max-h-[360px] bg-black rounded-2xl overflow-hidden shadow-2xl border border-slate-700 flex items-center justify-center">

      <!-- Video Element -->
      <video id="videoElement" autoplay playsinline muted class="w-full h-full object-cover transform -scale-x-100"></video>
      <canvas id="overlayCanvas" class="absolute inset-0 w-full h-full pointer-events-none transform -scale-x-100"></canvas>

      <!-- Face Oval Guide -->
      <div id="scannerOval" class="scanner-oval"></div>

      <!-- Model Loading Screen -->
      <div id="modelLoader" class="absolute inset-0 bg-slate-900/90 flex flex-col items-center justify-center p-6 text-center z-20">
        <div class="w-10 h-10 border-4 border-indigo-500 border-t-transparent rounded-full animate-spin mb-3"></div>
        <p class="text-sm font-semibold text-slate-200" id="loaderText">Preparing user verification</p>
        <p class="text-xs text-slate-400 mt-1">Please wait</p>
      </div>

      <!-- Live Instructions Overlay Badge -->
      <div id="livenessInstruction" class="absolute top-3 inset-x-3 bg-slate-900/85 backdrop-blur-md border border-slate-700/80 rounded-xl px-3 py-2 text-center shadow-lg z-10">
        <div id="instructionText" class="text-xs font-bold text-sky-300">
          Center your face in the frame
        </div>
        <div id="instructionSub" class="text-[11px] text-slate-400 mt-0.5">
          Use adequate lighting
        </div>
      </div>

      <!-- Live Indicators at Bottom of Camera -->
      <div class="absolute bottom-3 inset-x-3 flex items-center justify-between px-2 text-[11px] z-10">
        <div id="badgeFace" class="bg-slate-900/80 backdrop-blur px-2.5 py-1 rounded-full text-slate-300 border border-slate-700 flex items-center space-x-1.5">
          <span class="w-2 h-2 rounded-full bg-slate-500" id="dotFace"></span>
          <span id="textFace">Face not detected</span>
        </div>
        <div id="badgeLiveness" class="bg-slate-900/80 backdrop-blur px-2.5 py-1 rounded-full text-slate-300 border border-slate-700 flex items-center space-x-1.5">
          <span class="w-2 h-2 rounded-full bg-slate-500" id="dotLiveness"></span>
          <span id="textLiveness">Verification pending</span>
        </div>
      </div>
    </div>

    <!-- PUNCH CONTROLS (Punch Tab) -->
    <div id="punchControls" class="space-y-2">
      <div class="grid grid-cols-2 gap-3">
        <button
          id="btnPunchIn"
          onclick="triggerPunch('IN')"
          disabled
          class="bg-emerald-600 disabled:bg-slate-800 disabled:text-slate-600 disabled:cursor-not-allowed hover:bg-emerald-500 text-white font-bold py-3 px-4 rounded-xl shadow-lg transition flex flex-col items-center justify-center"
        >
          <span class="text-base tracking-wide">Clock In</span>
        </button>

        <button
          id="btnPunchOut"
          onclick="triggerPunch('OUT')"
          disabled
          class="bg-amber-600 disabled:bg-slate-800 disabled:text-slate-600 disabled:cursor-not-allowed hover:bg-amber-500 text-white font-bold py-3 px-4 rounded-xl shadow-lg transition flex flex-col items-center justify-center"
        >
          <span class="text-base tracking-wide">Clock Out</span>
        </button>
      </div>
      <p id="punchHint" class="text-center text-[11px] text-slate-500"></p>
    </div>

    <!-- ENROLL CONTROLS (Enroll Tab) -->
    <div id="enrollControls" class="hidden space-y-2">
      <button
        id="btnEnroll"
        onclick="triggerEnrollment()"
        disabled
        class="w-full bg-indigo-600 disabled:bg-slate-800 disabled:text-slate-600 disabled:cursor-not-allowed hover:bg-indigo-500 text-white font-bold py-3.5 px-4 rounded-xl shadow-lg transition flex items-center justify-center space-x-2"
      >
        <span>Register User</span>
      </button>
      <p id="enrollHint" class="text-center text-[11px] text-slate-400"></p>
    </div>

  </main>

  <!-- Status / Success / Error Modal -->
  <div id="statusModal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-slate-800 border border-slate-700 rounded-2xl max-w-sm w-full p-6 text-center shadow-2xl animate-fade-in">

      <div id="modalIcon" class="w-14 h-14 mx-auto rounded-full bg-indigo-600/20 text-indigo-400 flex items-center justify-center text-2xl mb-3">
        ⏳
      </div>

      <h3 id="modalTitle" class="text-lg font-bold text-white">Processing</h3>
      <p id="modalMessage" class="text-xs text-slate-300 mt-2 leading-relaxed">Please wait...</p>

      <!-- Active Animated Multi-Stage Progress Bar -->
      <div id="modalProgressWrap" class="mt-4 w-full bg-slate-700/60 rounded-full h-2.5 overflow-hidden border border-slate-600/50">
        <div id="modalProgressBar" class="bg-gradient-to-r from-indigo-500 via-sky-400 to-emerald-400 h-2.5 rounded-full transition-all duration-300 ease-out" style="width: 25%"></div>
      </div>
      <p id="modalStepText" class="text-[11px] font-medium text-indigo-300 mt-2">Verifying identity</p>

      <div id="modalDetails" class="hidden mt-4 pt-3 border-t border-slate-700 text-left text-xs space-y-1.5 bg-slate-900/60 p-3 rounded-xl font-mono text-slate-300">
        <div><span class="text-slate-500">Emp:</span> <span id="mEmp"></span></div>
        <div><span class="text-slate-500">Action:</span> <span id="mPunch"></span></div>
        <div><span class="text-slate-500">Time:</span> <span id="mTime"></span></div>
        <div><span class="text-slate-500">Site:</span> <span id="mSite"></span></div>
      </div>

      <button id="modalBtnClose" onclick="closeModal()" class="hidden mt-5 w-full bg-indigo-600 hover:bg-indigo-500 text-white font-bold py-2.5 rounded-xl text-xs transition">
        Done
      </button>
    </div>
  </div>

  <!-- JAVASCRIPT APPLICATION LOGIC -->
  <script>
    // -------------------------------------------------------------
    // BACKEND API CONNECTION CONFIGURATION
    // -------------------------------------------------------------
    const DEFAULT_APPS_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbxQTCzL5hY1ii5rHNsOq9eVHw5Ua-W3ST267ZYjQ2nOflJLoPwmzRQdfzafvPTboPRi/exec";
    let storedUrl = localStorage.getItem("ghcl_api_url");
    if (!storedUrl || storedUrl.includes("AKfycbyt6B2u7A1DtOhnERPnAcFDWcDnYgN5oVZZ")) {
      storedUrl = DEFAULT_APPS_SCRIPT_URL;
      localStorage.setItem("ghcl_api_url", DEFAULT_APPS_SCRIPT_URL);
    }
    let APPS_SCRIPT_URL = storedUrl;

    // Unified API Dispatcher: Handles both inside-Apps-Script and external hosting (Netlify, GitHub Pages, Vercel)
    async function callBackend(action, payloadData = {}) {
      // 1. If running inside Google Apps Script iframe
      if (typeof google !== 'undefined' && google.script && google.script.run) {
        return new Promise((resolve, reject) => {
          if (action === 'getInitialData') {
            google.script.run.withSuccessHandler(resolve).withFailureHandler(reject).getInitialData();
          } else if (action === 'getEmployeeProfile') {
            google.script.run.withSuccessHandler(resolve).withFailureHandler(reject).getEmployeeProfile(payloadData.query);
          } else if (action === 'enrollFaceBiometrics') {
            // FIX: livenessPassed is now passed to the server as the 4th argument
            google.script.run.withSuccessHandler(resolve).withFailureHandler(reject)
              .enrollFaceBiometrics(payloadData.empId, payloadData.faceVector, payloadData.snapshotBase64, payloadData.livenessPassed);
          } else if (action === 'submitAttendance') {
            google.script.run.withSuccessHandler(resolve).withFailureHandler(reject).submitAttendance(payloadData);
          } else {
            reject(new Error("Unknown action"));
          }
        });
      }

      // 2. If running externally on Netlify / GitHub Pages / Vercel:
      const bodyString = JSON.stringify({
        action: action,
        ...payloadData
      });

      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 30000);

      try {
        // Use Content-Type text/plain to avoid CORS OPTIONS preflight block on Google Apps Script!
        const response = await fetch(APPS_SCRIPT_URL, {
          method: "POST",
          headers: {
            "Content-Type": "text/plain;charset=utf-8"
          },
          body: bodyString,
          signal: controller.signal
        });
        clearTimeout(timeoutId);

        if (!response.ok) {
          throw new Error("HTTP " + response.status + ": " + response.statusText);
        }

        return await response.json();
      } catch (err) {
        clearTimeout(timeoutId);
        console.error("Backend fetch error:", err);
        if (err.name === 'AbortError') {
          throw new Error("The request timed out. Please try again.");
        }
        throw new Error("Unable to connect. Check your connection and try again.");
      }
    }

    // -------------------------------------------------------------
    // SYSTEM STATE VARIABLES
    // -------------------------------------------------------------
    let currentMode = 'punch'; // 'punch' or 'enroll'
    let systemLocations = [
      { id: "GHCL-NOIDA", name: "Corporate Office (Noida)", lat: 28.589722, lon: 77.312778, radius: 150 },
      { id: "GHCL-AHMD", name: "Registered Office (Ahmedabad)", lat: 23.035833, lon: 72.558611, radius: 150 },
      { id: "GHCL-PLANT", name: "Main Soda Ash Plant (Sutrapada)", lat: 20.855833, lon: 70.484444, radius: 600 },
      { id: "GHCL-MINE", name: "Sutrapada Limestone Mine (Gorakhamdhi)", lat: 20.991944, lon: 70.622222, radius: 1000 }
    ];
    let faceThreshold = 0.50;
    let currentUserProfile = null;
    let userLocation = null;
    let isGeofenceValid = false;
    let isFaceInOval = false;
    let nearestOffice = null;

    // Face & Liveness Detection State (Strict Anti-Proxy: Blocks ID Cards, Photos, Screens)
    let modelsLoaded = false;
    let isFaceDetected = false;
    let currentFaceDescriptor = null;
    let livenessPassed = false;
    let calibFrames = 0;
    let baselineEAR = 0;
    let baselineSmileRatio = 0;
    let baselineMAR = 0;
    let calibNoseX = 0;
    let calibNoseY = 0;
    let blinkState = 0; // 0 = uncalibrated, 1 = watching for blink, 2 = closure detected, 3 = verified
    let blinkCloseTime = 0;
    let smileFrames = 0;
    let staticSpoofFrames = 0;
    let consecutiveNoFaceFrames = 0;
    let isSubmitting = false;

    // ---- Fast blink liveness settings & state ----
    const BLINK = {
      closeRatio: 0.78,     // avg EAR must fall to <=78% of recent open-eye EAR
      eachEyeRatio: 0.88,   // EACH eye must fall to <=88% (real blinks are symmetric)
      reopenRatio: 0.90,    // eyes count as re-opened at >=90% of open EAR
      maxCloseMs: 1500,     // blink must finish within 1.5 s
      minOpenEAR: 0.17,     // ignore if "open" EAR is implausibly low
      historyLen: 14,       // frames of open-eye history
      maxFrameMotion: 0.18, // nose movement per frame / eye distance (card shaking)
      maxBlinkShift: 0.25,  // head shift during blink / eye distance
      maxVertChange: 0.10   // nose-length change (head tilt / photo tilt check)
    };
    let earHistory = [];
    let blinkRef = null;
    let blinkNose = null;
    let blinkVert = 0;
    let prevNose = null;
    let lastBoxCenter = null;
    let outOfOvalFrames = 0;
    let descriptorLocked = false;

    // DOM Elements
    const video = document.getElementById('videoElement');
    const overlayCanvas = document.getElementById('overlayCanvas');
    const scannerOval = document.getElementById('scannerOval');
    const modelLoader = document.getElementById('modelLoader');
    const loaderText = document.getElementById('loaderText');
    const instructionText = document.getElementById('instructionText');
    const instructionSub = document.getElementById('instructionSub');
    const badgeFace = document.getElementById('badgeFace');
    const dotFace = document.getElementById('dotFace');
    const textFace = document.getElementById('textFace');
    const badgeLiveness = document.getElementById('badgeLiveness');
    const dotLiveness = document.getElementById('dotLiveness');
    const textLiveness = document.getElementById('textLiveness');
    const btnPunchIn = document.getElementById('btnPunchIn');
    const btnPunchOut = document.getElementById('btnPunchOut');
    const btnEnroll = document.getElementById('btnEnroll');
    const punchHint = document.getElementById('punchHint');

    // 1. Clock Update
    setInterval(() => {
      const now = new Date();
      document.getElementById('liveClock').textContent = now.toLocaleTimeString([], { hour12: false });
    }, 1000);

    // 2. Initialize App on Page Load
    window.addEventListener('DOMContentLoaded', async () => {
      initCamera();
      loadFaceApiModels();
      fetchInitialServerData();
      refreshGPS();
    });

    // 3. Tab Switching
    function switchTab(mode) {
      currentMode = mode;
      resetLivenessState();

      const tabPunch = document.getElementById('tabPunch');
      const tabEnroll = document.getElementById('tabEnroll');
      const punchControls = document.getElementById('punchControls');
      const enrollControls = document.getElementById('enrollControls');

      if (mode === 'punch') {
        tabPunch.className = "px-3 py-1.5 rounded-md font-medium bg-indigo-600 text-white transition";
        tabEnroll.className = "px-3 py-1.5 rounded-md font-medium text-slate-400 hover:text-white transition";
        punchControls.classList.remove('hidden');
        enrollControls.classList.add('hidden');
        instructionText.textContent = "Center your face in the frame";
        instructionSub.textContent = "Blink or smile to verify your identity";
      } else {
        tabEnroll.className = "px-3 py-1.5 rounded-md font-medium bg-indigo-600 text-white transition";
        tabPunch.className = "px-3 py-1.5 rounded-md font-medium text-slate-400 hover:text-white transition";
        enrollControls.classList.remove('hidden');
        punchControls.classList.add('hidden');
        instructionText.textContent = "User registration";
        instructionSub.textContent = "Center your face in the frame";
      }
      evaluateControls();
    }

    // 4. Fetch Locations and Config from Apps Script Backend
    async function fetchInitialServerData() {
      try {
        const res = await callBackend('getInitialData');
        if (res && res.success) {
          if (res.locations && res.locations.length > 0) {
            systemLocations = res.locations;
          }
          faceThreshold = res.faceThreshold || 0.50;
          if (res.userEmail) {
            document.getElementById('empInput').value = res.userEmail;
            searchEmployee();
          }
          if (userLocation) validateGeofence();
        }
      } catch (err) {
        console.warn("Could not fetch remote initial data (using fallback locations):", err);
      }
    }

    // 5. GPS Geofencing Module
    function refreshGPS() {
      const geoTitle = document.getElementById('geoTitle');
      const geoSubtitle = document.getElementById('geoSubtitle');
      const geoPill = document.getElementById('geoPill');
      const geoIcon = document.getElementById('geoIcon');

      geoTitle.textContent = "Checking work location";
      geoSubtitle.textContent = "Please wait";
      geoPill.className = "bg-slate-800 border border-slate-700 rounded-xl p-3 flex items-center justify-between shadow-sm transition";
      geoIcon.textContent = "🛰️";

      if (!navigator.geolocation) {
        geoTitle.textContent = "Location unavailable";
        geoSubtitle.textContent = "This device does not support location services";
        geoPill.className = "bg-rose-950/40 border border-rose-700/60 rounded-xl p-3 flex items-center justify-between";
        geoIcon.textContent = "❌";
        isGeofenceValid = false;
        evaluateControls();
        return;
      }

      navigator.geolocation.getCurrentPosition(
        (pos) => {
          userLocation = {
            lat: pos.coords.latitude,
            lon: pos.coords.longitude,
            accuracy: pos.coords.accuracy
          };
          validateGeofence();
        },
        (err) => {
          geoTitle.textContent = "Location access required";
          geoSubtitle.textContent = "Allow location access in your browser settings";
          geoPill.className = "bg-rose-950/40 border border-rose-700/60 rounded-xl p-3 flex items-center justify-between";
          geoIcon.textContent = "🚫";
          isGeofenceValid = false;
          evaluateControls();
        },
        { enableHighAccuracy: true, timeout: 12000, maximumAge: 5000 }
      );
    }

    function validateGeofence() {
      if (!userLocation || !systemLocations.length) return;

      let nearest = null;
      let minDistance = Infinity;

      for (const loc of systemLocations) {
        const d = haversineDistance(userLocation.lat, userLocation.lon, loc.lat, loc.lon);
        if (d < minDistance) {
          minDistance = d;
          nearest = { ...loc, currentDistance: Math.round(d) };
        }
      }

      nearestOffice = nearest;
      const geoTitle = document.getElementById('geoTitle');
      const geoSubtitle = document.getElementById('geoSubtitle');
      const geoPill = document.getElementById('geoPill');
      const geoIcon = document.getElementById('geoIcon');

      if (nearest && nearest.currentDistance <= nearest.radius) {
        isGeofenceValid = true;
        geoTitle.textContent = "Location verified";
        geoSubtitle.textContent = nearest.name;
        geoPill.className = "bg-emerald-950/40 border border-emerald-600/60 rounded-xl p-3 flex items-center justify-between shadow-sm";
        geoIcon.textContent = "🟢";
      } else {
        isGeofenceValid = false;
        const distStr = nearest.currentDistance >= 1000
          ? (nearest.currentDistance / 1000).toFixed(2) + " km"
          : nearest.currentDistance + "m";
        geoTitle.textContent = "Outside authorized area";
        geoSubtitle.textContent = "Nearest site: " + nearest.name + " (" + distStr + " away)";
        geoPill.className = "bg-rose-950/40 border border-rose-600/60 rounded-xl p-3 flex items-center justify-between shadow-sm";
        geoIcon.textContent = "🔴";
      }

      evaluateControls();
    }

    function haversineDistance(lat1, lon1, lat2, lon2) {
      const R = 6371000;
      const dLat = (lat2 - lat1) * Math.PI / 180;
      const dLon = (lon2 - lon1) * Math.PI / 180;
      const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                Math.sin(dLon / 2) * Math.sin(dLon / 2);
      return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    }

