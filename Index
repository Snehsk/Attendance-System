        } else if (!isActive) {
          scannerOval.classList.add('error');
          instructionText.textContent = "Account inactive";
          instructionSub.textContent = "Contact HR for assistance";
          instructionText.className = "text-xs font-bold text-rose-400";
        } else if (currentUserProfile.isEnrolled) {
